{
  "name": "tptd",
  "version": "0.1.0",
  "private": true,
  "description": "Two-Player-Three-Dice: offline multiplayer casino dice game (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply tptd-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tptd-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.131.0"
  },
  "dependencies": {
    "hono": "^4.6.9"
  }
}
